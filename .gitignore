# Binary files
*.exe
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Local development
app.log

# Database files (jika ada SQLite dll)
*.db
*.sqlite
*.sqlite3

# Local configuration files
Setting.ini
Setting.ini.example
config.local.json

#Local environment variables
.env
.env.*
.env.example

# Uploads & User Generated Content
uploads/*

# sub-directory (images & documents)
!uploads/images/
!uploads/documents/

# Ignore all files in the sub-directories
uploads/images/*
uploads/documents/*

# But keep .gitkeep files
!uploads/.gitkeep
!uploads/images/.gitkeep
!uploads/documents/.gitkeep
