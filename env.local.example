# Salin file ini menjadi .env lalu isi sesuai PostgreSQL lokal Anda
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ganti_password_anda
DB_NAME=kpi_system
DB_SSLMODE=disable

APP_PORT=8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

JWT_SECRET=ganti_dengan_secret_anda
JWT_EXPIRY_HOURS=24

# Opsional
ENABLE_WHATSAPP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
